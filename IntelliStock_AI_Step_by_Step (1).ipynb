        "id": "062b7637"
      },
      "source": [
        "### Dataset Visualizations\n",
        "Below we visualize basic trends and distributions of our combined transaction data (such as transaction volume over time and top purchasing countries)."
      ],
      "id": "062b7637"
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 272
        },
        "id": "2383fe71",
        "outputId": "90333a9e-207f-4048-be03-3565d55456f1"
      },
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Configure style\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n",
        "\n",
        "# Plot 1: Top 10 Countries by Transaction Count (excluding United Kingdom for scale)\n",
        "df_no_uk = df[df['Country'] != 'United Kingdom']\n",
        "top_countries = df_no_uk['Country'].value_counts().head(10)\n",
        "sns.barplot(ax=axes[0], x=top_countries.values, y=top_countries.index, palette=\"viridis\")\n",
        "axes[0].set_title(\"Top 10 International Markets (Excl. UK)\")\n",
        "axes[0].set_xlabel(\"Number of Transactions\")\n",
        "\n",
        "# Plot 2: Monthly Transaction Volume over Time\n",
        "df['YearMonth'] = df['InvoiceDate'].dt.to_period('M')\n",
        "monthly_transactions = df.groupby('YearMonth').size()\n",
        "monthly_transactions.plot(kind='line', ax=axes[1], marker='o', color='royalblue', linewidth=2)\n",
        "axes[1].set_title(\"Monthly Transaction Volume Over Time\")\n",
        "axes[1].set_xlabel(\"Month\")\n",
        "axes[1].set_ylabel(\"Number of Invoices\")\n",
        "axes[1].tick_params(axis='x', rotation=45)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "2383fe71",
      "execution_count": 22,
