        "id": "625a51c3",
        "outputId": "a6b61025-9eed-45e9-ea3c-b6af7149938b"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Extracting zipped archive: online+retail+ii (1).zip\n",
            "Ready to use Excel file path: /content/online_retail_II.xlsx\n"
          ]
        }
      ],
      "source": [
        "import zipfile\n",
        "import os\n",
        "from google.colab import files\n",
        "\n",
        "# Get the list of uploaded files\n",
        "uploaded_files = [f for f in os.listdir('/content') if f.endswith('.zip')]\n",
        "\n",
        "if not uploaded_files:\n",
        "    uploaded = files.upload()\n",
        "    filename = next(iter(uploaded))\n",
        "else:\n",
        "    filename = uploaded_files[-1] # Use the most recent uploaded zip file\n",
        "\n",
        "# Unzip the file and find the excel file inside\n",
        "print(f\"Extracting zipped archive: {filename}\")\n",
        "with zipfile.ZipFile(os.path.join('/content', filename), 'r') as zip_ref:\n",
        "    zip_ref.extractall('/content/')\n",
        "    extracted_files = zip_ref.namelist()\n",
        "    xlsx_files = [f for f in extracted_files if f.endswith('.xlsx')]\n",
        "    if xlsx_files:\n",
        "        filename = os.path.join('/content/', xlsx_files[0])\n",
        "    else:\n",
        "        raise ValueError(\"Could not find an Excel (.xlsx) file inside the uploaded zip archive.\")\n",
        "\n",
        "print(\"Ready to use Excel file path:\", filename)"
      ]
    },
